petiole main

import "net/http"
import "stdlib/env"
import "stdlib/errors" as errs
import "stdlib/http" as httppkg
import "stdlib/log"
import "stdlib/profile"
import "time"

import "github.com/Iribala/town-builder/internal/config"
import "github.com/Iribala/town-builder/internal/middleware/bodylimit"
import "github.com/Iribala/town-builder/internal/middleware/cors"
import "github.com/Iribala/town-builder/internal/middleware/ratelimit"
import "github.com/Iribala/town-builder/internal/middleware/requestid"
import "github.com/Iribala/town-builder/internal/middleware/secheaders"
import "github.com/Iribala/town-builder/internal/routes/router"
import "github.com/Iribala/town-builder/internal/storage"

func main()
    config.LoadEnvFile(".env")
    s, err := config.Load()
    if err isnt empty
        log.Fatal("Failed to load config: {err}")
    log.Info("Starting {s.AppTitle} v{s.AppVersion} ({s.Environment})")

    serr := storage.Initialize(s.RedisURL)
    if serr isnt empty
        log.Warn("Redis init failed, using in-memory fallback: {serr}")
    defer storage.Close()

    cors.Init()
    secheaders.Init()

    mux := router.NewMux()
    handler := httppkg.TrustedHosts(
        requestid.Wrap(bodylimit.Wrap(cors.Wrap(secheaders.Wrap(ratelimit.Wrap(mux))))),
        many s.AllowedHosts,
    )

    addr := ":5001"
    log.Info("Listening on {addr}")
    # Explicit server with timeouts (Slowloris mitigation). WriteTimeout stays
    # 0 on purpose: /events is a long-lived SSE stream and a per-response
    # write deadline would sever it. Slowloris is bound by ReadHeaderTimeout.
    srv := reference of http.Server{
        Addr: addr,
        Handler: handler,
        ReadHeaderTimeout: 10 * time.Second,
        ReadTimeout: 60 * time.Second,
        WriteTimeout: 0,
        IdleTimeout: 120 * time.Second,
    }

    serve := func() error
        lerr := srv.ListenAndServe()
        if lerr isnt empty
            return errs.Wrap(lerr, "server error")
        return empty
    # CPU profiling is opt-in: TOWN_BUILDER_CPU_PROFILE names the output path.
    profilePath := env.GetOr("TOWN_BUILDER_CPU_PROFILE", "")
    if profilePath isnt empty
        log.Info("CPU profile enabled", "path", profilePath)
        profile.CPU(profilePath, serve) onerr
            log.Fatal("Server error: {error}")

        return
    serve() onerr
        log.Fatal("Server error: {error}")
