petiole cors

import "net/http"
import "stdlib/env"
import "stdlib/http" as httphelper
import "stdlib/log"
import "stdlib/string" as strpkg

import "github.com/Iribala/town-builder/internal/config"

var allowedOrigins: list of string

func Init()
    s := config.Current()
    if s equals empty
        allowedOrigins = empty list of string
        return
    cleaned := env.SplitAndTrim(s.AllowedOrigins, ",")
    if len(cleaned) equals 0 and strpkg.EqualFold(s.Environment, "development")
        cleaned = list of string{"http://localhost:3000", "http://localhost:5001", "http://127.0.0.1:5001"}
        log.Warn("Using default development CORS origins. Set ALLOWED_ORIGINS in production!")
    allowedOrigins = cleaned
    log.Info("CORS allowed origins: {allowedOrigins}")

func Wrap(next: http.Handler) http.Handler
    return httphelper.CORS(next, httphelper.CORSOptions{
        AllowedOrigins: allowedOrigins,
        AllowedMethods: list of string{"GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"},
        AllowedHeaders: list of string{"*"},
        AllowCredentials: true,
    })
