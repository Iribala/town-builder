petiole requestid

import "context"
import "net/http"
import "stdlib/http" as httphelper

# Wrap assigns a time-ordered request ID (uuid v7) to every request —
# honoring an inbound X-Request-ID when the caller supplied one — echoes
# it on the response, and stores it for handlers via FromContext.
func Wrap(next: http.Handler) http.Handler
    return httphelper.RequestID(next)

# FromContext returns the request ID assigned by Wrap, or "" outside a
# wrapped chain.
func FromContext(ctx: context.Context) string
    return httphelper.RequestIDFromContext(ctx)
