petiole ui

import "html/template"
import "net/http"
import "os"
import "stdlib/crypto"
import "stdlib/http" as httphelper
import "stdlib/json"
import "stdlib/log"
import "stdlib/string" as strpkg

import "github.com/Iribala/town-builder/internal/config"
import "github.com/Iribala/town-builder/internal/middleware/secheaders"
import "github.com/Iribala/town-builder/internal/routes/static" as staticroute
import "github.com/Iribala/town-builder/internal/services/kibigia_auth"
import "github.com/Iribala/town-builder/internal/services/model_display_names"
import "github.com/Iribala/town-builder/internal/services/model_loader"

var indexTmpl: reference template.Template

func titleCase(s: string) string
    if s is empty
        return s
    return strpkg.ToUpper(s[:1]) + s[1:]

func loadTemplate() error
    s := config.Current()
    if s equals empty
        return error "config not loaded"
    path := s.TemplatesPath + "/index.html"
    raw, err := os.ReadFile(path)
    if err isnt empty
        return err
    funcs := template.FuncMap{
        "title": titleCase,
        "displayName": model_display_names.GetModelDisplayName,
        "staticURL": staticroute.URL,
    }
    t, perr := template.New("index.html").Funcs(funcs).Parse(raw as string)
    if perr isnt empty
        return perr
    indexTmpl = t
    return empty

func basePath() string
    s := config.Current()
    if s equals empty
        return ""
    return strpkg.TrimRight(s.RootPath, "/")

# embedPayload renders the server-embed JSON consumed by embed.js and
# wasm-init.js. The index handler injects it into a <script type="application/json">
# raw-text element; `</` is escaped as `<\/` (valid JSON, inert HTML) so an
# attacker-supplied token cannot terminate the block early.
func embedPayload(token: string) string
    embed := map of string to string{
        "BasePath": basePath(),
        "Token": token,
        "StaticVersion": staticroute.Version(),
        "WasmURL": staticroute.URL("/static/wasm/physics_greentea.wasm"),
    }
    raw, err := json.Bytes(embed)
    if err isnt empty
        log.Error("embed: marshal failed: {err}")
        return "{}"
    return strpkg.ReplaceAll(raw as string, "</", "<\\/")

# newNonce returns a per-response CSP nonce for the import map.
func newNonce() (string, error)
    raw, err := crypto.RandomToken(16)
    if err isnt empty
        return "", err
    return raw, empty

type indexData
    Models: map of string to list of string
    EmbedJSON: template.JS
    Nonce: string

func index(response: httphelper.Response, request: httphelper.Request)
    if indexTmpl equals empty
        if err := loadTemplate(); err isnt empty
            log.Error("Failed to load index template: {err}")
            response.JSONError("template load failed", 500) onerr discard
            return

    # ?code= from kibigia's auth-code flow; ?token= is the direct-token fallback.
    authCode := request.URL().Query().Get("code")
    directToken := request.URL().Query().Get("token")
    token := kibigia_auth.ResolveToken(authCode, directToken)

    nonce, nerr := newNonce()
    if nerr isnt empty
        log.Error("Failed to generate CSP nonce: {nerr}")
        response.JSONError("unable to render page", 500) onerr discard
        return

    data := indexData{
        Models: model_loader.GetAvailableModels(),
        EmbedJSON: template.JS(embedPayload(token)),
        Nonce: nonce,
    }
    w := response.Raw()
    w.Header().Set("Content-Type", "text/html; charset=utf-8")
    # The page embeds the caller's JWT (#server-embed); never let it be cached.
    w.Header().Set("Cache-Control", "no-store")
    # Strict CSP with the per-response nonce for the import map; overrides
    # the global policy set by the secheaders middleware.
    w.Header().Set("Content-Security-Policy", secheaders.ContentSecurityPolicyWithNonce(nonce))
    if err := indexTmpl.Execute(w, data); err isnt empty
        log.Error("Failed to render index: {err}")

func favicon(response: httphelper.Response, request: httphelper.Request)
    path := "static/favicon.ico"
    if _, err := os.Stat(path); err isnt empty
        response.JSONNotFound("Favicon not found") onerr discard
        return
    response.ServeFile(request, path)

# kuki:suppress "exported-nonnull-reference" "deliberate carrier: internal app API — Kukicha enforces non-null at call sites; no Go consumers"
func Register(mux: reference http.ServeMux)
    mux.Handle("GET /\{$\}", httphelper.Handler(index))
    mux.Handle("GET /favicon.ico", httphelper.Handler(favicon))
