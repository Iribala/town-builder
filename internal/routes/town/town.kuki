petiole town

import "net/http"
import "stdlib/cast"
import "stdlib/http" as httphelper
import "stdlib/json"
import "stdlib/log"
import "stdlib/sandbox"
import "stdlib/string" as strpkg

import "github.com/Iribala/town-builder/internal/config"
import "github.com/Iribala/town-builder/internal/events" as evt
import "github.com/Iribala/town-builder/internal/mapx"
import "github.com/Iribala/town-builder/internal/normalization"
import "github.com/Iribala/town-builder/internal/routes/common"
import "github.com/Iribala/town-builder/internal/services/django_client"
import "github.com/Iribala/town-builder/internal/services/town_helpers"
import "github.com/Iribala/town-builder/internal/storage"
import "github.com/Iribala/town-builder/internal/utils/geometry"
import "github.com/Iribala/town-builder/internal/utils/security"

func getTown(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    data, err := storage.Get()
    if err isnt empty
        response.JSONError("Failed to load town data", 500) onerr discard
        return
    response.JSON(data) onerr discard

func updateTown(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    data := empty map of string to any
    err := request.ReadJSON(reference of data)
    if err isnt empty
        response.JSONBadRequest("Invalid JSON body") onerr discard
        return
    townData, gerr := storage.Get()
    if gerr isnt empty
        response.JSONError("Failed to load town data", 500) onerr discard
        return
    if mapx.Has(data, "townName") and len(data) equals 1
        name := mapx.Str(data, "townName")
        townData["townName"] = name
        town_helpers.SaveAndBroadcast(
            townData,
            map of string to any{"type": "name", "townName": name},
        ) onerr discard
        log.Info("Updated town name to: {name}")
        response.JSON(map of string to any{"status": "success"}) onerr discard
        return
    if mapx.Has(data, "driver") and mapx.Has(data, "id") and mapx.Has(data, "category")
        category := mapx.Str(data, "category")
        modelID := mapx.Str(data, "id")
        driver := mapx.Str(data, "driver")
        updated := false
        v, vok := townData[category]
        if vok
            if v is list of any as arr
                for i from 0 to len(arr)
                    if arr[i] is map of string to any as entry
                        if mapx.Str(entry, "id") equals modelID
                            entry["driver"] = driver
                            arr[i] = entry
                            townData[category] = arr
                            updated = true
                            town_helpers.SaveAndBroadcast(townData, map of string to any{
                                "type": "driver",
                                "category": category,
                                "id": modelID,
                                "driver": driver,
                            }) onerr discard
                            log.Info("Updated driver for {category} id={modelID} to {driver}")
                            break
        if not updated
            response.JSONNotFound("Model not found") onerr discard
            return
        response.JSON(map of string to any{"status": "success"}) onerr discard
        return
    canonical := normalization.Normalize(data)
    town_helpers.SaveAndBroadcast(canonical, evt.Full(canonical)) onerr discard
    response.JSON(map of string to any{"status": "success"}) onerr discard

type townRouter
    root: sandbox.Root
    dataPath: string
    initErr: error

func newTownRouter() townRouter
    s := config.Current()
    dataPath := "./data"
    if s isnt empty
        dataPath = s.DataPath
    root, err := sandbox.New(dataPath)
    return townRouter{root: root, dataPath: dataPath, initErr: err}

func normalizeFilename(name: string) string
    base := strpkg.TrimSuffix(name, ".json")
    return base + ".json"

func saveTown on h: townRouter(response: httphelper.Response, request: httphelper.Request)
    if h.initErr isnt empty
        response.JSONError("Data directory unavailable", 500) onerr discard
        return
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    payload := empty map of string to any
    err := request.ReadJSON(reference of payload)
    if err isnt empty
        response.JSONBadRequest("Invalid JSON payload") onerr discard
        return
    rawData, hasData := payload["data"]
    if not hasData
        response.JSONBadRequest("data is required") onerr discard
        return
    filename := mapx.Str(payload, "filename")
    if filename equals "" and not mapx.Has(payload, "filename")
        filename = "town_data.json"
    townName := mapx.Str(payload, "townName")
    canonical := normalization.Normalize(rawData)
    localMsg := ""
    if filename isnt ""
        fn := normalizeFilename(filename)
        _, perr := security.SafeFilepath(fn, h.dataPath, list of string{".json"})
        if perr isnt empty
            response.JSONBadRequest("Invalid filename") onerr discard
            return
        bytes, jerr := json.PrettyBytes(canonical)
        if jerr isnt empty
            response.JSONError("Failed to encode town data", 500) onerr discard
            return
        werr := h.root.WriteString(bytes as string, fn)
        if werr isnt empty
            response.JSONError("Failed to write file", 500) onerr discard
            return
        log.Info("Town saved locally to {fn}")
        localMsg = "Town saved locally to {fn}."
    else
        localMsg = "Local save skipped (no filename)."
    town_helpers.SaveAndBroadcast(canonical, evt.Full(canonical)) onerr discard
    djangoMsg := ""
    var townID: any = empty
    if v, vok := payload["town_id"]; vok and not cast.IsNil(v)
        townID = v
    if not cast.IsNil(townID)
        idInt := 0
        if townID is float64 as f
            idInt = f as int
        _, derr := django_client.UpdateTown(idInt, payload, canonical, townName)
        if derr isnt empty
            log.Error("Error updating town in Django: {derr}")
            djangoMsg = " Warning: failed to sync to Django backend: {derr}"
        else
            djangoMsg = " Town updated in Django backend (ID: {idInt})."
    else
        searchName := townName
        if searchName equals ""
            if rawData is map of string to any as m
                searchName = mapx.Str(m, "townName")
                if searchName equals ""
                    searchName = mapx.Str(m, "name")
        if searchName isnt ""
            existingID, found, serr := django_client.SearchTownByName(searchName)
            if serr equals empty and found
                _, uerr := django_client.UpdateTown(existingID, payload, canonical, townName)
                if uerr isnt empty
                    djangoMsg = " Warning: failed to sync to Django backend: {uerr}"
                else
                    townID = existingID
                    djangoMsg = " Town updated in Django backend (ID: {existingID})."
            else
                result, cerr := django_client.CreateTown(payload, canonical, townName)
                if cerr isnt empty
                    djangoMsg = " Warning: failed to sync to Django backend: {cerr}"
                else
                    if v, vok := result["town_id"]; vok
                        townID = v
                    djangoMsg = " Town created in Django backend."
        else
            result, cerr := django_client.CreateTown(payload, canonical, townName)
            if cerr isnt empty
                djangoMsg = " Warning: failed to sync to Django backend: {cerr}"
            else
                if v, vok := result["town_id"]; vok
                    townID = v
                djangoMsg = " Town created in Django backend."
    response.JSON(map of string to any{
        "status": "success",
        "message": "{localMsg}{djangoMsg}",
        "town_id": townID,
    }) onerr discard

func loadTown on h: townRouter(response: httphelper.Response, request: httphelper.Request)
    if h.initErr isnt empty
        response.JSONError("Data directory unavailable", 500) onerr discard
        return
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    body := empty map of string to any
    request.ReadJSON(reference of body) onerr discard
    filename := mapx.Str(body, "filename")
    if filename equals ""
        filename = "town_data.json"
    fn := normalizeFilename(filename)
    _, perr := security.SafeFilepath(fn, h.dataPath, list of string{".json"})
    if perr isnt empty
        response.JSONBadRequest("Invalid filename") onerr discard
        return
    if not h.root.Exists(fn)
        response.JSONNotFound("File {fn} not found") onerr discard
        return
    raw, rerr := h.root.Read(fn)
    if rerr isnt empty
        response.JSONError("Failed to read file", 500) onerr discard
        return
    var townData: any
    jerr := json.ParseBytesInto(raw, reference of townData)
    if jerr isnt empty
        response.JSONError("Failed to parse town data", 500) onerr discard
        return
    canonical := normalization.Normalize(townData)
    town_helpers.SaveAndBroadcast(canonical, evt.Full(canonical)) onerr discard
    log.Info("Town loaded from {fn}")
    response.JSON(map of string to any{
        "status": "success",
        "message": "Town loaded from {fn}",
        "data": canonical,
    }) onerr discard

func loadFromDjango(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    idStr := request.PathValue("id")
    idInt, perr := cast.ToInt(idStr)
    if perr isnt empty
        response.JSONBadRequest("Invalid town id") onerr discard
        return
    townData, derr := django_client.GetTownByID(idInt)
    if derr isnt empty
        response.JSONError("Failed to load town from Django: {derr}", 500) onerr discard
        return
    log.Info("Loaded town {idInt} from Django: {mapx.Str(townData, "name")}")
    var layoutData: any
    if v, vok := townData["layout_data"]; vok
        layoutData = v
    else
        layoutData = empty list of any
    canonical := normalization.Normalize(layoutData)
    town_helpers.SaveAndBroadcast(canonical, evt.Full(canonical)) onerr discard
    info := map of string to any{
        "id": townData["id"],
        "name": townData["name"],
        "description": townData["description"],
        "latitude": townData["latitude"],
        "longitude": townData["longitude"],
    }
    if cs, csok := townData["category_statuses"]; csok
        info["category_statuses"] = cs
    else
        info["category_statuses"] = empty list of any
    response.JSON(map of string to any{
        "status": "success",
        "message": "Town '{mapx.Str(townData, "name")}' loaded from Django",
        "data": canonical,
        "town_info": info,
    }) onerr discard

func deleteModel(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    body := empty map of string to any
    err := request.ReadJSON(reference of body)
    if err isnt empty
        response.JSONBadRequest("Invalid JSON body") onerr discard
        return
    category := mapx.Str(body, "category")
    modelID := mapx.Str(body, "id")
    pos, hasPos := mapx.MapAt(body, "position")
    if category equals "" or modelID equals "" and not hasPos
        response.JSONBadRequest("Missing required parameters") onerr discard
        return
    townData, gerr := storage.Get()
    if gerr isnt empty
        response.JSONError("Failed to load town data", 500) onerr discard
        return
    v, vok := townData[category]
    if not vok
        response.JSONNotFound("Model not found") onerr discard
        return
    if v is list of any as arr
        if modelID isnt ""
            for i from 0 to len(arr)
                if arr[i] is map of string to any as entry
                    if mapx.Str(entry, "id") equals modelID
                        newArr := empty list of any
                        for j from 0 to len(arr)
                            if j isnt i
                                newArr = append(newArr, arr[j])
                        townData[category] = newArr
                        town_helpers.SaveAndBroadcast(townData, map of string to any{
                            "type": "delete",
                            "category": category,
                            "id": modelID,
                        }) onerr discard
                        response.JSON(map of string to any{
                            "status": "success",
                            "message": "Deleted model with ID {modelID}",
                        }) onerr discard
                        return
            response.JSONNotFound("Model not found") onerr discard
            return
        closestIdx := -1
        closestDist := 1e308
        for i from 0 to len(arr)
            if arr[i] is map of string to any as entry
                mp, _v := mapx.MapAt(entry, "position")
                d := geometry.CalculateDistance(pos, mp)
                if d < closestDist
                    closestDist = d
                    closestIdx = i
        if closestIdx >= 0 and closestDist < geometry.DeleteProximityThreshold
            var deletedID: any = ""
            if arr[closestIdx] is map of string to any as del
                deletedID = mapx.Str(del, "id")
            newArr := empty list of any
            for j from 0 to len(arr)
                if j isnt closestIdx
                    newArr = append(newArr, arr[j])
            townData[category] = newArr
            town_helpers.SaveAndBroadcast(townData, map of string to any{
                "type": "delete",
                "category": category,
                "position": pos,
                "deleted_id": deletedID,
            }) onerr discard
            px := pos["x"]
            py := pos["y"]
            pz := pos["z"]
            response.JSON(map of string to any{
                "status": "success",
                "message": "Deleted model at position ({px}, {py}, {pz})",
            }) onerr discard
            return
    response.JSONNotFound("Model not found") onerr discard

func editModel(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    body := empty map of string to any
    err := request.ReadJSON(reference of body)
    if err isnt empty
        response.JSONBadRequest("Invalid JSON body") onerr discard
        return
    category := mapx.Str(body, "category")
    modelID := mapx.Str(body, "id")
    if category equals "" or modelID equals ""
        response.JSONBadRequest("Missing required parameters") onerr discard
        return
    townData, gerr := storage.Get()
    if gerr isnt empty
        response.JSONError("Failed to load town data", 500) onerr discard
        return
    v, vok := townData[category]
    if not vok
        response.JSONNotFound("Model not found") onerr discard
        return
    if v is list of any as arr
        for i from 0 to len(arr)
            if arr[i] is map of string to any as entry
                if mapx.Str(entry, "id") equals modelID
                    if pos, pok := mapx.MapAt(body, "position"); pok
                        entry["position"] = pos
                    if rot, rok := mapx.MapAt(body, "rotation"); rok
                        entry["rotation"] = rot
                    if scl, sok := mapx.MapAt(body, "scale"); sok
                        entry["scale"] = scl
                    arr[i] = entry
                    townData[category] = arr
                    town_helpers.SaveAndBroadcast(townData, map of string to any{
                        "type": "edit",
                        "category": category,
                        "id": modelID,
                        "data": entry,
                    }) onerr discard
                    response.JSON(map of string to any{
                        "status": "success",
                        "message": "Updated model with ID {modelID}",
                    }) onerr discard
                    return
    response.JSONNotFound("Model not found") onerr discard

func getConfig(response: httphelper.Response, request: httphelper.Request)
    u, ok := common.CurrentUser(response, request)
    if not ok
        return
    response.JSON(map of string to any{
        "apiUrl": "/api/proxy/towns",
        "authenticated": true,
        "user": u.Username,
    }) onerr discard

func Register(mux: reference http.ServeMux)
    h := newTownRouter()
    if h.initErr isnt empty
        log.Error("Failed to open data directory: {h.initErr}")
    mux.Handle("GET /api/town", httphelper.Handler(getTown))
    mux.Handle("POST /api/town", httphelper.Handler(updateTown))
    mux.Handle("POST /api/town/save", httphelper.Handler(h.saveTown))
    mux.Handle("POST /api/town/load", httphelper.Handler(h.loadTown))
    mux.Handle(`GET /api/town/load-from-django/{id}`, httphelper.Handler(loadFromDjango))
    mux.Handle("DELETE /api/town/model", httphelper.Handler(deleteModel))
    mux.Handle("PUT /api/town/model", httphelper.Handler(editModel))
    mux.Handle("GET /api/config", httphelper.Handler(getConfig))
