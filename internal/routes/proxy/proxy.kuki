petiole proxy

import "io"
import "net/http"
import "stdlib/http" as httphelper
import "stdlib/log"
import "stdlib/maps" as mapspkg
import "stdlib/string" as strpkg

import "github.com/Iribala/town-builder/internal/routes/common"
import "github.com/Iribala/town-builder/internal/services/django_client"

var skipRequestHeaders = list of string{"host", "content-length"}

var skipResponseHeaders = list of string{"content-length", "transfer-encoding", "connection", "content-encoding"}

func shouldSkip(skip: list of string, name: string) bool
    return strpkg.ToLower(name) in skip

func collectHeaders(src: map of string to list of string) map of string to string
    out := empty map of string to string
    for k in mapspkg.Keys(src)
        if shouldSkip(skipRequestHeaders, k)
            continue
        vs := src[k]
        if len(vs) > 0
            out[k] = vs[0]
    return out

func collectParams(values: map of string to list of string) map of string to string
    out := empty map of string to string
    for k in mapspkg.Keys(values)
        vs := values[k]
        if len(vs) > 0
            out[k] = vs[0]
    return out

func handle(response: httphelper.Response, request: httphelper.Request, method: string)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    r := request.Raw()
    path := r.PathValue("path")
    headers := collectHeaders(r.Header)
    params := collectParams(r.URL.Query())

    var body: list of byte
    if r.Body isnt empty
        raw, ierr := io.ReadAll(r.Body)
        if ierr isnt empty
            response.JSONBadRequest("Failed to read request body") onerr discard
            return
        body = raw

    resp, perr := django_client.ProxyRequest(method, path, headers, params, body)
    if perr isnt empty
        msg := perr.Error()
        log.Warn("Proxy request failed: {msg}")
        if strpkg.Contains(msg, "timeout")
            response.JSONError("Request to upstream service timed out", 504) onerr discard
            return
        if strpkg.Contains(msg, "not allowed") or strpkg.Contains(msg, "Unsupported") or strpkg.Contains(msg, "must not contain") or strpkg.Contains(msg, "disallowed")
            response.JSONBadRequest(msg) onerr discard
            return
        response.JSONError(msg, 502) onerr discard
        return

    w := response.Raw()
    for k in mapspkg.Keys(resp.Headers)
        if shouldSkip(skipResponseHeaders, k)
            continue
        for v in resp.Headers[k]
            w.Header().Add(k, v)

    w.WriteHeader(resp.StatusCode)
    if len(resp.Body) > 0
        w.Write(resp.Body) onerr discard

func get(response: httphelper.Response, request: httphelper.Request)
    handle(response, request, "GET")

func post(response: httphelper.Response, request: httphelper.Request)
    handle(response, request, "POST")

func put(response: httphelper.Response, request: httphelper.Request)
    handle(response, request, "PUT")

func patch(response: httphelper.Response, request: httphelper.Request)
    handle(response, request, "PATCH")

func remove(response: httphelper.Response, request: httphelper.Request)
    handle(response, request, "DELETE")

func Register(mux: reference http.ServeMux)
    mux.Handle("GET /api/proxy/towns/\{path...}", httphelper.Handler(get))
    mux.Handle("POST /api/proxy/towns/\{path...}", httphelper.Handler(post))
    mux.Handle("PUT /api/proxy/towns/\{path...}", httphelper.Handler(put))
    mux.Handle("PATCH /api/proxy/towns/\{path...}", httphelper.Handler(patch))
    mux.Handle("DELETE /api/proxy/towns/\{path...}", httphelper.Handler(remove))
    mux.Handle("GET /api/proxy/towns", httphelper.Handler(get))
    mux.Handle("POST /api/proxy/towns", httphelper.Handler(post))
