petiole common

import "stdlib/http" as httphelper
import "stdlib/string" as strpkg

import "github.com/Iribala/town-builder/internal/services/auth"

func ExtractToken(request: httphelper.Request) string
    h := httphelper.GetHeader(request.Raw(), "Authorization")
    if h equals ""
        return ""
    if strpkg.HasPrefix(h, "Bearer ")
        return h[7:]
    return h

func CurrentUser(response: httphelper.Response, request: httphelper.Request) (reference auth.UserInfo, bool)
    token := ExtractToken(request)
    u, err := auth.GetCurrentUser(token)
    if err isnt empty
        response.JSONUnauthorized("Not authenticated") onerr discard
        return empty, false
    return u, true
