petiole models

import "net/http"
import "os"
import "path/filepath"
import "stdlib/http" as httphelper
import "stdlib/url" as urlpkg

import "github.com/Iribala/town-builder/internal/config"
import "github.com/Iribala/town-builder/internal/routes/common"
import "github.com/Iribala/town-builder/internal/services/model_loader"
import "github.com/Iribala/town-builder/internal/utils/security"

func listModels(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    response.JSON(model_loader.GetAvailableModels()) onerr discard

func getModel(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    category := request.PathValue("category")
    modelName := request.PathValue("model_name")
    vc, vn, err := security.ValidateModelPath(category, modelName)
    if err isnt empty
        response.JSONBadRequest("Invalid model path") onerr discard
        return
    s := config.Current()
    if s equals empty
        response.JSONError("config not loaded", 500) onerr discard
        return
    modelPath := filepath.Join(s.ModelsPath, vc, vn)
    if not urlpkg.IsSubpath(s.ModelsPath, modelPath)
        response.JSONBadRequest("Invalid model path") onerr discard
        return
    _, statErr := os.Stat(modelPath)
    if statErr isnt empty
        response.JSONNotFound("Model not found") onerr discard
        return
    info := request.URL().Query().Get("info")
    if info equals "1"
        # Minimal metadata (GLTF parsing deferred; Python used pygltflib).
        body := map of string to any{
            "name": modelName,
            "category": category,
            "has_bin": fileExists(modelPath[:len(modelPath) - len(filepath.Ext(modelPath))] + ".bin"),
        }
        response.JSON(body) onerr discard
        return
    response.ServeFile(request, modelPath)

func fileExists(path: string) bool
    _, err := os.Stat(path)
    return err equals empty

func Register(mux: reference http.ServeMux)
    mux.Handle("GET /api/models", httphelper.Handler(listModels))
    mux.Handle(`GET /api/model/{category}/{model_name}`, httphelper.Handler(getModel))
