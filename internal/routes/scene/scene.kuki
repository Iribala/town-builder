petiole scene

import "net/http"
import "stdlib/http" as httphelper
import "stdlib/log"

import "github.com/Iribala/town-builder/internal/normalization"
import "github.com/Iribala/town-builder/internal/routes/common"
import "github.com/Iribala/town-builder/internal/services/scene_description"
import "github.com/Iribala/town-builder/internal/storage"

func description(response: httphelper.Response, request: httphelper.Request)
    u, ok := common.CurrentUser(response, request)
    if not ok
        return
    data, err := storage.Get()
    if err isnt empty
        response.JSONError("Failed to load town data", 500) onerr discard
        return
    result := scene_description.GenerateSceneDescription(data)
    log.Info("Scene description requested by {u.Username}")
    response.JSON(map of string to any{"status": "success", "data": result}) onerr discard

func stats(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    data, err := storage.Get()
    if err isnt empty
        response.JSONError("Failed to load town data", 500) onerr discard
        return
    out := empty map of string to any
    if name, nok := data["townName"]; nok
        out["town_name"] = name
    else
        out["town_name"] = "Unnamed Town"
    total := 0
    for cat in normalization.Categories
        n := 0
        if v, vok := data[cat]; vok
            if v is list of any as arr
                n = len(arr)
        out[cat] = n
        total = total + n
    out["total"] = total
    log.Info("Scene stats requested: {total} total objects")
    response.JSON(map of string to any{"status": "success", "data": out}) onerr discard

func Register(mux: reference http.ServeMux)
    mux.Handle("GET /api/scene/description", httphelper.Handler(description))
    mux.Handle("GET /api/scene/stats", httphelper.Handler(stats))
