petiole terrain

import "net/http"
import "stdlib/cast"
import "stdlib/http" as httphelper

import "github.com/Iribala/town-builder/internal/services/terrain" as terrainsvc
import "github.com/Iribala/town-builder/internal/storage"

# TerrainTile returns a cached terrain tile for the given z/x/y coordinates.
# When a `src` query parameter is supplied (and its host is allowlisted), the
# tile is fetched from the upstream provider and cached; otherwise a metadata
# stub is returned.
func tile(response: httphelper.Response, request: httphelper.Request)
    z := 14
    if zv, zerr := cast.ToInt(request.PathValue("z")); zerr equals empty
        z = zv
    x := 0
    if xv, xerr := cast.ToInt(request.PathValue("x")); xerr equals empty
        x = xv
    y := 0
    if yv, yerr := cast.ToInt(request.PathValue("y")); yerr equals empty
        y = yv
    cacheKey := terrainsvc.CacheKey(z, x, y)
    src := request.Raw().URL.Query().Get("src")
    if src isnt empty
        data, err := terrainsvc.FetchTile(src, cacheKey)
        if err isnt empty
            response.JSONError("Failed to fetch terrain tile: {err}", 502) onerr discard
            return
        w := response.Raw()
        w.Header().Set("Cache-Control", "public, max-age=300")
        w.Header().Set("Vary", "Accept-Encoding")
        response.JSON(data) onerr discard
        return
    meta := map of string to any{
        "z": z,
        "x": x,
        "y": y,
        "cache_key": cacheKey,
        "schema_version": terrainsvc.SchemaVersion,
    }
    # Serve from cache when present.
    cached, cerr := storage.CacheGet(cacheKey)
    if cerr equals empty
        w := response.Raw()
        w.Header().Set("Cache-Control", "public, max-age=300")
        w.Header().Set("Vary", "Accept-Encoding")
        response.JSON(cached) onerr discard
        return
    w := response.Raw()
    w.Header().Set("Cache-Control", "public, max-age=300")
    w.Header().Set("Vary", "Accept-Encoding")
    response.JSON(meta) onerr discard

# kuki:suppress "exported-nonnull-reference" "deliberate carrier: internal app API — Kukicha enforces non-null at call sites; no Go consumers"
func Register(mux: reference http.ServeMux)
    mux.Handle(`GET /api/terrain/{z}/{x}/{y}`, httphelper.Handler(tile))
