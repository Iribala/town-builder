petiole cursor

import "net/http"
import "stdlib/http" as httphelper

import "github.com/Iribala/town-builder/internal/mapx"
import "github.com/Iribala/town-builder/internal/routes/common"
import "github.com/Iribala/town-builder/internal/services/town_helpers"

func readPosition(raw: any) map of string to any
    m, _ := mapx.AsMap(raw)
    return map of string to any{
        "x": mapx.FloatAt(m, "x", 0.0),
        "y": mapx.FloatAt(m, "y", 0.0),
        "z": mapx.FloatAt(m, "z", 0.0),
    }

func update(response: httphelper.Response, request: httphelper.Request)
    u, ok := common.CurrentUser(response, request)
    if not ok
        return
    body := make(map of string to any)
    err := request.ReadJSON(reference of body)
    if err isnt empty
        response.JSONBadRequest("Invalid JSON body") onerr discard
        return
    pos := readPosition(body["position"])
    cam := readPosition(body["camera_position"])
    event := map of string to any{
        "type": "cursor",
        "username": u.Username,
        "position": pos,
        "camera_position": cam,
    }
    town_helpers.BroadcastSSE(event)
    response.JSON(map of string to any{"status": "success", "message": "Cursor position updated"}) onerr discard

func Register(mux: reference http.ServeMux)
    mux.Handle("POST /api/cursor/update", httphelper.Handler(update))
