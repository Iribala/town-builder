petiole buildings

import "net/http"
import "stdlib/cast"
import "stdlib/crypto"
import "stdlib/http" as httphelper
import "stdlib/log"

import "github.com/Iribala/town-builder/internal/events" as evt
import "github.com/Iribala/town-builder/internal/mapx"
import "github.com/Iribala/town-builder/internal/normalization"
import "github.com/Iribala/town-builder/internal/object"
import "github.com/Iribala/town-builder/internal/routes/common"
import "github.com/Iribala/town-builder/internal/services/town_helpers"
import "github.com/Iribala/town-builder/internal/storage"

func toResponse(building: map of string to any, category: string) map of string to any
    o := object.FromMap(building)
    out := map of string to any{
        "id": o.ID,
        "model": o.Model,
        "category": category,
        "position": o.Position,
        "rotation": o.Rotation,
        "scale": o.Scale,
    }
    if not cast.IsNil(o.Driver)
        out["driver"] = o.Driver
    return out

func findBuilding(townData: map of string to any, buildingID: string) (string, map of string to any, int)
    for category in normalization.Categories
        v, ok := townData[category]
        if not ok
            continue
        if v is list of any as arr
            for i from 0 to len(arr)
                if arr[i] is map of string to any as entry
                    if mapx.Str(entry, "id") equals buildingID
                        return category, entry, i
    return "", empty, -1

func newID() string
    raw, err := crypto.RandomToken(8)
    if err isnt empty
        return "obj_00000000"
    return "obj_" + raw[:8]

func categoryList(townData: map of string to any, category: string) list of any
    return mapx.ListOr(townData, category)

func setCategory(townData: map of string to any, category: string, arr: list of any)
    townData[category] = arr

func create(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    body := make(map of string to any)
    err := request.ReadJSON(reference of body)
    if err isnt empty
        response.JSONBadRequest("Invalid JSON body") onerr discard
        return
    model := mapx.Str(body, "model")
    if model equals ""
        response.JSONBadRequest("model is required") onerr discard
        return
    category := mapx.Str(body, "category")
    if category equals ""
        category = "buildings"
    if _, pok := mapx.MapAt(body, "position"); not pok
        response.JSONBadRequest("position is required") onerr discard
        return
    buildingID := newID()
    var posV object.Vec3 = object.Vec3FromAny(body["position"], 0.0, 0.0, 0.0)
    var rotV object.Vec3 = object.Vec3FromAny(body["rotation"], 0.0, 0.0, 0.0)
    var sclV object.Vec3 = object.Vec3FromAny(body["scale"], 1.0, 1.0, 1.0)
    building := object.ToMap(object.PlacedObject{
        ID: buildingID,
        Model: model,
        Position: posV,
        Rotation: rotV,
        Scale: sclV,
    })
    townData, gerr := storage.Get()
    if gerr isnt empty
        response.JSONError("Failed to load town data", 500) onerr discard
        return
    arr := categoryList(townData, category)
    arr = append(arr, building as any)
    setCategory(townData, category, arr)
    err = town_helpers.SaveAndBroadcast(townData, evt.Full(townData))
    if err isnt empty
        response.JSONError("Failed to save", 500) onerr discard
        return
    log.Info("Created building: {buildingID} ({model}) in category {category}")
    response.JSONStatus(toResponse(building, category), 201) onerr discard

func list(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    townData, err := storage.Get()
    if err isnt empty
        response.JSONError("Failed to load town data", 500) onerr discard
        return
    cat := request.URL().Query().Get("category")
    cats := normalization.Categories
    if cat isnt ""
        cats = list of string{cat}
    out := empty list of map of string to any
    for c in cats
        v, vok := townData[c]
        if not vok
            continue
        if v is list of any as arr
            for item in arr
                if item is map of string to any as mm
                    out = append(out, toResponse(mm, c))
    log.Info("Listed {len(out)} buildings")
    response.JSON(out) onerr discard

func get(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    id := request.PathValue("id")
    townData, err := storage.Get()
    if err isnt empty
        response.JSONError("Failed to load town data", 500) onerr discard
        return
    cat, b, _ := findBuilding(townData, id)
    if b equals empty
        response.JSONNotFound("Building with ID {id} not found") onerr discard
        return
    response.JSON(toResponse(b, cat)) onerr discard

func update(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    id := request.PathValue("id")
    body := make(map of string to any)
    err := request.ReadJSON(reference of body)
    if err isnt empty
        response.JSONBadRequest("Invalid JSON body") onerr discard
        return
    townData, gerr := storage.Get()
    if gerr isnt empty
        response.JSONError("Failed to load town data", 500) onerr discard
        return
    cat, b, idx := findBuilding(townData, id)
    if b equals empty
        response.JSONNotFound("Building with ID {id} not found") onerr discard
        return
    arr := categoryList(townData, cat)
    # b is the building entry findBuilding located at idx (arr[idx] is the
    # same map reference); use it directly so current stays a typed map.
    current := b
    if pos, pok := mapx.MapAt(body, "position"); pok
        current["position"] = pos
    if rot, rok := mapx.MapAt(body, "rotation"); rok
        current["rotation"] = rot
    if scl, sok := mapx.MapAt(body, "scale"); sok
        current["scale"] = scl
    if m := mapx.Str(body, "model"); m isnt ""
        current["model"] = m
    newCat := mapx.Str(body, "category")
    if newCat isnt "" and newCat isnt cat
        # Remove from current category
        newArr := empty list of any
        for i from 0 to len(arr)
            if i isnt idx
                newArr = append(newArr, arr[i])
        setCategory(townData, cat, newArr)
        # Add to new category
        destArr := categoryList(townData, newCat)
        destArr = append(destArr, current as any)
        setCategory(townData, newCat, destArr)
        cat = newCat
    else
        arr[idx] = current
        setCategory(townData, cat, arr)
    err = town_helpers.SaveAndBroadcast(townData, map of string to any{
        "type": "edit",
        "category": cat,
        "id": id,
        "data": current,
    })
    if err isnt empty
        response.JSONError("Failed to save", 500) onerr discard
        return
    log.Info("Updated building: {id}")
    response.JSON(toResponse(current, cat)) onerr discard

func remove(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    id := request.PathValue("id")
    townData, err := storage.Get()
    if err isnt empty
        response.JSONError("Failed to load town data", 500) onerr discard
        return
    cat, _, idx := findBuilding(townData, id)
    if idx equals -1
        response.JSONNotFound("Building with ID {id} not found") onerr discard
        return
    arr := categoryList(townData, cat)
    newArr := empty list of any
    for i from 0 to len(arr)
        if i isnt idx
            newArr = append(newArr, arr[i])
    setCategory(townData, cat, newArr)
    serr := town_helpers.SaveAndBroadcast(townData, map of string to any{
        "type": "delete",
        "category": cat,
        "id": id,
    })
    if serr isnt empty
        response.JSONError("Failed to save", 500) onerr discard
        return
    log.Info("Deleted building: {id} from category {cat}")
    response.JSON(map of string to any{
        "status": "success",
        "message": "Building {id} deleted successfully",
    }) onerr discard

func Register(mux: reference http.ServeMux)
    mux.Handle("POST /api/buildings", httphelper.Handler(create))
    mux.Handle("GET /api/buildings", httphelper.Handler(list))
    mux.Handle(`GET /api/buildings/{id}`, httphelper.Handler(get))
    mux.Handle(`PUT /api/buildings/{id}`, httphelper.Handler(update))
    mux.Handle(`DELETE /api/buildings/{id}`, httphelper.Handler(remove))
