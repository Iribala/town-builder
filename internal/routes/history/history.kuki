petiole history

import "net/http"
import "stdlib/cast"
import "stdlib/http" as httphelper
import "stdlib/log"

import "github.com/Iribala/town-builder/internal/events" as evt
import "github.com/Iribala/town-builder/internal/mapx"
import "github.com/Iribala/town-builder/internal/routes/common"
import "github.com/Iribala/town-builder/internal/services/history" as histsvc
import "github.com/Iribala/town-builder/internal/services/town_helpers"
import "github.com/Iribala/town-builder/internal/storage"

func getHistory(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    limit := httphelper.GetQueryIntOr(request.Raw(), "limit", 50)
    entries := histsvc.GetHistory(limit)
    response.JSON(map of string to any{
        "status": "success",
        "history": entries,
        "can_undo": histsvc.CanUndo(),
        "can_redo": histsvc.CanRedo(),
    }) onerr discard

func restoreState(response: httphelper.Response, entry: map of string to any, stateKey: string, action: string, pastTense: string, pushBack: func(map of string to any)) bool
    sv, sok := entry[stateKey]
    if not sok or cast.IsNil(sv)
        response.JSONBadRequest("Cannot {action}: no {stateKey}") onerr discard
        return false
    if sv is map of string to any as state
        err := storage.Set(state)
        if err isnt empty
            response.JSONError("Failed to save state", 500) onerr discard
            return false
        pushBack(entry)
        town_helpers.BroadcastSSE(evt.Full(state))
        op := mapx.Str(entry, "operation")
        log.Info("{action} operation: {op}")
        response.JSON(map of string to any{
            "status": "success",
            "message": "{pastTense} {op} operation",
            "can_undo": histsvc.CanUndo(),
            "can_redo": histsvc.CanRedo(),
        }) onerr discard
        return true
    else
        response.JSONBadRequest("Cannot {action}: invalid {stateKey}") onerr discard
        return false

func undo(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    if not histsvc.CanUndo()
        response.JSONBadRequest("Nothing to undo") onerr discard
        return
    entry, eok := histsvc.PopLastEntry()
    if not eok
        response.JSONBadRequest("Failed to get last operation") onerr discard
        return
    restoreState(response, entry, "before_state", "undo", "Undid", histsvc.PushRedoEntry)

func redoPushBack(entry: map of string to any)
    histsvc.AddEntry(
        mapx.Str(entry, "operation"),
        mapx.Str(entry, "category"),
        mapx.Str(entry, "object_id"),
        mapx.MapOr(entry, "before_state"),
        mapx.MapOr(entry, "after_state"),
    ) onerr discard

func redo(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    if not histsvc.CanRedo()
        response.JSONBadRequest("Nothing to redo") onerr discard
        return
    entry, eok := histsvc.PopRedoEntry()
    if not eok
        response.JSONBadRequest("Failed to get redo operation") onerr discard
        return
    restoreState(response, entry, "after_state", "redo", "Redid", redoPushBack)

func clearHist(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    histsvc.ClearHistory()
    response.JSON(map of string to any{"status": "success", "message": "History cleared"}) onerr discard

func Register(mux: reference http.ServeMux)
    mux.Handle("GET /api/history", httphelper.Handler(getHistory))
    mux.Handle("POST /api/history/undo", httphelper.Handler(undo))
    mux.Handle("POST /api/history/redo", httphelper.Handler(redo))
    mux.Handle("DELETE /api/history", httphelper.Handler(clearHist))
