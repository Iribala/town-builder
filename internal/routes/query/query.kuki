petiole query

import "net/http"
import "stdlib/cast"
import "stdlib/http" as httphelper

import "github.com/Iribala/town-builder/internal/mapx"
import "github.com/Iribala/town-builder/internal/routes/common"
import "github.com/Iribala/town-builder/internal/services/query" as querysvc

func readBody(request: httphelper.Request) (map of string to any, bool)
    body := make(map of string to any)
    err := httphelper.ReadJSON(request.Raw(), reference of body)
    if err isnt empty
        return empty, false
    return body, true

func writeResults(response: httphelper.Response, results: list of map of string to any)
    response.JSON(map of string to any{
        "status": "success",
        "count": len(results),
        "results": results,
    }) onerr discard

func radius(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    body, bok := readBody(request)
    if not bok
        response.JSONBadRequest("Invalid JSON body") onerr discard
        return
    results := querysvc.SpatialQueryRadius(
        mapx.MapOr(body, "center"),
        mapx.FloatAt(body, "radius", 0.0),
        mapx.Str(body, "category"),
        mapx.IntAt(body, "limit", 0),
    )
    writeResults(response, results)

func bounds(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    body, bok := readBody(request)
    if not bok
        response.JSONBadRequest("Invalid JSON body") onerr discard
        return
    results := querysvc.SpatialQueryBounds(
        mapx.MapOr(body, "min"),
        mapx.MapOr(body, "max"),
        mapx.Str(body, "category"),
        mapx.IntAt(body, "limit", 0),
    )
    writeResults(response, results)

func nearest(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    body, bok := readBody(request)
    if not bok
        response.JSONBadRequest("Invalid JSON body") onerr discard
        return
    hasMaxDist := false
    maxDist := 0.0
    if v, vok := body["max_distance"]; vok and not cast.IsNil(v)
        if v is float64 as f
            hasMaxDist = true
            maxDist = f
    results := querysvc.SpatialQueryNearest(
        mapx.MapOr(body, "point"),
        mapx.Str(body, "category"),
        mapx.IntAt(body, "count", 1),
        maxDist,
        hasMaxDist,
    )
    writeResults(response, results)

func advanced(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    body, bok := readBody(request)
    if not bok
        response.JSONBadRequest("Invalid JSON body") onerr discard
        return
    filters := empty list of map of string to any
    if v, vok := body["filters"]; vok
        if v is list of any as arr
            for item in arr
                if item is map of string to any as mm
                    filters = append(filters, mm)
    sortOrder := mapx.Str(body, "sort_order")
    if sortOrder equals ""
        sortOrder = "asc"
    results := querysvc.AdvancedQuery(
        mapx.Str(body, "category"),
        filters,
        mapx.Str(body, "sort_by"),
        sortOrder,
        mapx.IntAt(body, "limit", 0),
        mapx.IntAt(body, "offset", 0),
    )
    writeResults(response, results)

func Register(mux: reference http.ServeMux)
    mux.Handle("POST /api/query/spatial/radius", httphelper.Handler(radius))
    mux.Handle("POST /api/query/spatial/bounds", httphelper.Handler(bounds))
    mux.Handle("POST /api/query/spatial/nearest", httphelper.Handler(nearest))
    mux.Handle("POST /api/query/advanced", httphelper.Handler(advanced))
