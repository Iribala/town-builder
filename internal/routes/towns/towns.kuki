petiole towns

import "net/http"
import "stdlib/http" as httphelper

import "github.com/Iribala/town-builder/internal/routes/common"
import "github.com/Iribala/town-builder/internal/storage"

func mine(response: httphelper.Response, request: httphelper.Request)
    u, ok := common.CurrentUser(response, request)
    if not ok
        return
    ids := storage.TownIDsByOwner(u.Did)
    towns := empty list of map of string to any
    for id in ids
        towns = append(towns, map of string to any{"town_id": id})
    response.JSON(map of string to any{"towns": towns, "count": len(towns)}) onerr discard

func byOwner(response: httphelper.Response, request: httphelper.Request)
    u, ok := common.CurrentUser(response, request)
    if not ok
        return
    did := request.PathValue("did")
    # Only the owner (or a dev token without a DID claim) may enumerate their towns.
    if u.Did isnt empty and u.Did isnt did
        response.JSONError("Not authorized to list this DID's towns", 403) onerr discard
        return
    ids := storage.TownIDsByOwner(did)
    towns := empty list of map of string to any
    for id in ids
        towns = append(towns, map of string to any{"town_id": id})
    response.JSON(map of string to any{"towns": towns, "count": len(towns)}) onerr discard

# kuki:suppress "exported-nonnull-reference" "deliberate carrier: internal app API — Kukicha enforces non-null at call sites; no Go consumers"
func Register(mux: reference http.ServeMux)
    mux.Handle(`GET /api/towns/mine`, httphelper.Handler(mine))
    mux.Handle(`GET /api/towns/by-owner/{did}`, httphelper.Handler(byOwner))
