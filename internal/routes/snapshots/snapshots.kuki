petiole snapshots

import "net/http"
import "stdlib/http" as httphelper
import "stdlib/log"

import "github.com/Iribala/town-builder/internal/events" as evt
import "github.com/Iribala/town-builder/internal/mapx"
import "github.com/Iribala/town-builder/internal/routes/common"
import "github.com/Iribala/town-builder/internal/services/snapshots" as snapsvc
import "github.com/Iribala/town-builder/internal/services/town_helpers"
import "github.com/Iribala/town-builder/internal/storage"

func create(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    body := make(map of string to any)
    httphelper.ReadJSON(request.Raw(), reference of body) onerr discard
    townData, err := storage.Get()
    if err isnt empty
        response.JSONError("Failed to load town data", 500) onerr discard
        return
    snapID, serr := snapsvc.CreateSnapshot(townData, mapx.Str(body, "name"), mapx.Str(body, "description"))
    if serr isnt empty
        response.JSONError("Failed to create snapshot", 500) onerr discard
        return
    meta, _ := snapsvc.GetSnapshotMetadata(snapID)
    response.JSON(map of string to any{
        "status": "success",
        "message": "Snapshot created",
        "snapshot": meta,
    }) onerr discard

func list(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    items := snapsvc.ListSnapshots()
    response.JSON(map of string to any{
        "status": "success",
        "snapshots": items,
    }) onerr discard

func get(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    id := request.PathValue("id")
    data, dok := snapsvc.GetSnapshot(id)
    if not dok
        response.JSONNotFound("Snapshot not found") onerr discard
        return
    meta, _ := snapsvc.GetSnapshotMetadata(id)
    response.JSON(map of string to any{
        "status": "success",
        "snapshot": meta,
        "data": data,
    }) onerr discard

func restore(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    id := request.PathValue("id")
    data, dok := snapsvc.GetSnapshot(id)
    if not dok
        response.JSONNotFound("Snapshot not found") onerr discard
        return
    err := storage.Set(data)
    if err isnt empty
        response.JSONError("Failed to restore", 500) onerr discard
        return
    town_helpers.BroadcastSSE(evt.Full(data))
    meta, _ := snapsvc.GetSnapshotMetadata(id)
    log.Info("Restored snapshot: {id}")
    name := ""
    if meta isnt empty
        name = mapx.Str(meta, "name")
    response.JSON(map of string to any{
        "status": "success",
        "message": "Restored to snapshot: {name}",
        "snapshot": meta,
    }) onerr discard

func remove(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    id := request.PathValue("id")
    if not snapsvc.DeleteSnapshot(id)
        response.JSONNotFound("Snapshot not found") onerr discard
        return
    response.JSON(map of string to any{
        "status": "success",
        "message": "Snapshot deleted",
    }) onerr discard

func Register(mux: reference http.ServeMux)
    mux.Handle("POST /api/snapshots", httphelper.Handler(create))
    mux.Handle("GET /api/snapshots", httphelper.Handler(list))
    mux.Handle(`GET /api/snapshots/{id}`, httphelper.Handler(get))
    mux.Handle(`POST /api/snapshots/{id}/restore`, httphelper.Handler(restore))
    mux.Handle(`DELETE /api/snapshots/{id}`, httphelper.Handler(remove))
