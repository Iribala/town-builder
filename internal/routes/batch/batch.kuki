petiole batch

import "net/http"
import "stdlib/http" as httphelper
import "stdlib/log"

import "github.com/Iribala/town-builder/internal/config"
import "github.com/Iribala/town-builder/internal/routes/common"
import "github.com/Iribala/town-builder/internal/services/batch" as batchsvc

func executeOps(response: httphelper.Response, request: httphelper.Request)
    _, ok := common.CurrentUser(response, request)
    if not ok
        return
    body := make(map of string to any)
    err := request.ReadJSON(reference of body)
    if err isnt empty
        response.JSONBadRequest("Invalid JSON body") onerr discard
        return
    opsRaw, opsOk := body["operations"]
    if not opsOk
        response.JSONBadRequest("operations is required") onerr discard
        return
    if opsRaw is list of any as opsList
        s := config.Current()
        maxOps := 100
        if s isnt empty and s.MaxBatchOperations > 0
            maxOps = s.MaxBatchOperations
        if len(opsList) > maxOps
            response.JSONBadRequest("operations exceeds limit") onerr discard
            return
        ops := empty list of map of string to any
        for item in opsList
            if item is map of string to any as m
                ops = append(ops, m)
            else
                response.JSONBadRequest("each operation must be an object") onerr discard
                return
        checkRequired := true
        if v, vok := body["check_required_fields"]; vok
            if v is bool as b
                checkRequired = b
        results, successful, failed := batchsvc.ExecuteOperations(ops, checkRequired)
        status := "success"
        if failed > 0
            status = "partial"
        log.Info("Batch operations: {successful} ok, {failed} failed")
        response.JSON(map of string to any{
            "status": status,
            "results": results,
            "successful": successful,
            "failed": failed,
        }) onerr discard
    else
        response.JSONBadRequest("operations must be a list") onerr discard
        return

func Register(mux: reference http.ServeMux)
    mux.Handle("POST /api/batch/operations", httphelper.Handler(executeOps))
