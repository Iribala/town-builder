petiole config

import "os"
import "stdlib/env"
import "stdlib/files"
import "stdlib/string" as strpkg
import "time"

type Settings
    AppTitle: string
    AppDescription: string
    AppVersion: string
    Environment: string
    JwtSecretKey: string
    JwtAlgorithm: string
    DisableJwtAuth: bool
    ApiURL: string
    ApiToken: string
    KibigiaExchangeURL: string
    KibigiaExchangeSecret: string
    RedisURL: string
    PubsubChannel: string
    ModelsPath: string
    StaticPath: string
    TemplatesPath: string
    DataPath: string
    RootPath: string
    SseTimeout: time.Duration
    SseKeepaliveInterval: time.Duration
    UserActivityTimeout: time.Duration
    MaxHistorySize: int
    MaxSnapshots: int
    MaxRequestBodyBytes: int64
    MaxBatchOperations: int
    MaxSseConnectionsPerUser: int
    AllowedOrigins: string
    AllowedDomains: string
    AllowedApiDomains: list of string
    AllowedHosts: list of string

var current: reference Settings

func durationOr(key: string, def: time.Duration) time.Duration
    return env.GetDurationOr(key, def) onerr def

# LoadEnvFile reads a .env file (KEY=VALUE per line, '#' comments, optional
# surrounding quotes on values) and sets each entry into the process
# environment WITHOUT overriding variables already present. The real
# environment (shell or container) always wins; .env only fills gaps. Call
# this once at startup, before Load().
func LoadEnvFile(path: string)
    content, err := files.ReadString(path)
    if err isnt empty
        return
    for line in strpkg.Lines(content)
        trimmed := strpkg.TrimSpace(line)
        if trimmed equals "" or strpkg.HasPrefix(trimmed, "#")
            continue
        key, val, found := strpkg.Cut(trimmed, "=")
        if not found
            continue
        key = strpkg.TrimSpace(key)
        val = stripQuotes(strpkg.TrimSpace(val))
        if key equals ""
            continue
        if os.Getenv(key) isnt ""
            continue
        # os.Setenv is an external call (no onerr); check its error explicitly.
        if serr := os.Setenv(key, val); serr isnt empty
            continue

func stripQuotes(s: string) string
    if len(s) >= 2
        if strpkg.HasPrefix(s, "\"") and strpkg.HasSuffix(s, "\"")
            return strpkg.TrimPrefix(strpkg.TrimSuffix(s, "\""), "\"")
        if strpkg.HasPrefix(s, "'") and strpkg.HasSuffix(s, "'")
            return strpkg.TrimPrefix(strpkg.TrimSuffix(s, "'"), "'")
    return s

func Load() (reference Settings, error)
    disableJwtAuth := env.GetBoolOr("DISABLE_JWT_AUTH", false) onerr false
    maxHistory := env.GetIntOr("MAX_HISTORY_SIZE", 100) onerr 100
    maxSnapshots := env.GetIntOr("MAX_SNAPSHOTS", 50) onerr 50
    maxRequestBodyBytesInt := env.GetIntOr("MAX_REQUEST_BODY_BYTES", 10 * 1024 * 1024) onerr 10 * 1024 * 1024
    maxBatch := env.GetIntOr("MAX_BATCH_OPERATIONS", 100) onerr 100
    maxSse := env.GetIntOr("MAX_SSE_CONNECTIONS_PER_USER", 3) onerr 3
    s := reference of Settings{
        AppTitle: env.GetOr("APP_TITLE", "Town Builder API"),
        AppDescription: env.GetOr(
            "APP_DESCRIPTION",
            "Interactive 3D town building application with real-time collaboration",
        ),
        AppVersion: env.GetOr("APP_VERSION", "1.0.0"),
        Environment: env.GetOr("ENVIRONMENT", "development"),
        JwtSecretKey: env.GetOr("JWT_SECRET_KEY", ""),
        JwtAlgorithm: env.GetOr("JWT_ALGORITHM", "HS256"),
        DisableJwtAuth: disableJwtAuth,
        ApiURL: env.GetOr("TOWN_API_URL", "http://localhost:8000/api/towns/"),
        ApiToken: env.GetOr("TOWN_API_JWT_TOKEN", ""),
        KibigiaExchangeURL: env.GetOr("KIBIGIA_EXCHANGE_URL", "http://localhost:8000/issues/town-builder/exchange/"),
        KibigiaExchangeSecret: env.GetOr("KIBIGIA_EXCHANGE_SECRET", ""),
        RedisURL: env.GetOr("REDIS_URL", "redis://localhost:6379/0"),
        PubsubChannel: env.GetOr("PUBSUB_CHANNEL", "town_events"),
        ModelsPath: env.GetOr("MODELS_PATH", "./static/models"),
        StaticPath: env.GetOr("STATIC_PATH", "./static"),
        TemplatesPath: env.GetOr("TEMPLATES_PATH", "./templates"),
        DataPath: env.GetOr("DATA_PATH", "./data"),
        RootPath: env.GetOr("ROOT_PATH", ""),
        SseTimeout: durationOr("SSE_TIMEOUT", 10 * time.Second),
        SseKeepaliveInterval: durationOr("SSE_KEEPALIVE_INTERVAL", 10 * time.Second),
        UserActivityTimeout: durationOr("USER_ACTIVITY_TIMEOUT", 30 * time.Second),
        MaxHistorySize: maxHistory,
        MaxSnapshots: maxSnapshots,
        MaxRequestBodyBytes: maxRequestBodyBytesInt as int64,
        MaxBatchOperations: maxBatch,
        MaxSseConnectionsPerUser: maxSse,
        AllowedOrigins: env.GetOr("ALLOWED_ORIGINS", ""),
        AllowedDomains: env.GetOr("ALLOWED_DOMAINS", "localhost,127.0.0.1"),
    }

    s.AllowedApiDomains = env.SplitAndTrim(s.AllowedDomains, ",")
    s.AllowedHosts = env.SplitAndTrim(env.GetOr("ALLOWED_HOSTS", "localhost,127.0.0.1"), ",")

    if not s.DisableJwtAuth and s.JwtSecretKey equals ""
        return empty, error "JWT_SECRET_KEY environment variable must be set when JWT authentication is enabled. Set JWT_SECRET_KEY to a secure random string or set DISABLE_JWT_AUTH=true for development."

    current = s
    return s, empty

func Current() reference Settings
    return current

func SetForTest(s: reference Settings)
    current = s
