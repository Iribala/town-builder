petiole query

import "math"
import "stdlib/cast"
import "stdlib/log"
import "stdlib/sort"
import "stdlib/string" as strpkg

import "github.com/Iribala/town-builder/internal/mapx"
import "github.com/Iribala/town-builder/internal/storage"
import "github.com/Iribala/town-builder/internal/utils/geometry"

func getAllCategories(townData: map of string to any) list of string
    keys := empty list of string
    for k, v in townData
        if k equals "snapshots" or k equals "history"
            continue
        if v is list of any
            keys = append(keys, k)
    return keys

func sortByDistance(items: list of map of string to any)
    sort.ByKey(items, (it: map of string to any) => cast.ToFloat64Or(it["distance"], 0.0))

func cloneWithCat(obj: map of string to any, cat: string) map of string to any
    out := empty map of string to any
    for k, v in obj
        out[k] = v
    out["category"] = cat
    return out

func SpatialQueryRadius(center: map of string to any, radius: float64, category: string, limit: int) list of map of string to any
    townData := storage.Get() onerr empty
    results := empty list of map of string to any
    cats := empty list of string
    if category isnt ""
        cats = list of string{category}
    else
        cats = getAllCategories(townData)
    for cat in cats
        catVal, ok := townData[cat]
        if not ok
            continue
        if catVal is list of any as items
            for item in items
                obj, mok := mapx.AsMap(item)
                if not mok
                    continue
                pos, _ := mapx.AsMap(obj["position"])
                distance := geometry.CalculateDistance(center, pos)
                if distance <= radius
                    entry := cloneWithCat(obj, cat)
                    entry["distance"] = distance
                    results = append(results, entry)
    sortByDistance(results)
    if limit > 0 and len(results) > limit
        results = results[:limit]
    log.Info("Radius query: found {len(results)} objects within {radius} units")
    return results

func isWithinBounds(point: map of string to any, minPoint: map of string to any, maxPoint: map of string to any) bool
    # Missing/unparseable bounds default to ±Inf, leaving that axis unbounded.
    px := mapx.FloatAt(point, "x", 0.0)
    py := mapx.FloatAt(point, "y", 0.0)
    pz := mapx.FloatAt(point, "z", 0.0)
    mnx := mapx.FloatAt(minPoint, "x", math.Inf(-1))
    mny := mapx.FloatAt(minPoint, "y", math.Inf(-1))
    mnz := mapx.FloatAt(minPoint, "z", math.Inf(-1))
    mxx := mapx.FloatAt(maxPoint, "x", math.Inf(1))
    mxy := mapx.FloatAt(maxPoint, "y", math.Inf(1))
    mxz := mapx.FloatAt(maxPoint, "z", math.Inf(1))
    return mnx <= px and px <= mxx and mny <= py and py <= mxy and mnz <= pz and pz <= mxz

func SpatialQueryBounds(minPoint: map of string to any, maxPoint: map of string to any, category: string, limit: int) list of map of string to any
    townData := storage.Get() onerr empty
    results := empty list of map of string to any
    cats := empty list of string
    if category isnt ""
        cats = list of string{category}
    else
        cats = getAllCategories(townData)
    for cat in cats
        catVal, ok := townData[cat]
        if not ok
            continue
        if catVal is list of any as items
            for item in items
                obj, mok := mapx.AsMap(item)
                if not mok
                    continue
                pos, _ := mapx.AsMap(obj["position"])
                if isWithinBounds(pos, minPoint, maxPoint)
                    results = append(results, cloneWithCat(obj, cat))
    if limit > 0 and len(results) > limit
        results = results[:limit]
    log.Info("Bounds query: found {len(results)} objects")
    return results

func SpatialQueryNearest(point: map of string to any, category: string, count: int, maxDistance: float64, hasMaxDistance: bool) list of map of string to any
    townData := storage.Get() onerr empty
    results := empty list of map of string to any
    cats := empty list of string
    if category isnt ""
        cats = list of string{category}
    else
        cats = getAllCategories(townData)
    for cat in cats
        catVal, ok := townData[cat]
        if not ok
            continue
        if catVal is list of any as items
            for item in items
                obj, mok := mapx.AsMap(item)
                if not mok
                    continue
                pos, _ := mapx.AsMap(obj["position"])
                distance := geometry.CalculateDistance(point, pos)
                if not hasMaxDistance or distance <= maxDistance
                    entry := cloneWithCat(obj, cat)
                    entry["distance"] = distance
                    results = append(results, entry)
    sortByDistance(results)
    if count > 0 and len(results) > count
        results = results[:count]
    log.Info("Nearest query: found {len(results)} objects")
    return results

func getNestedValue(obj: map of string to any, field: string) any
    parts := strpkg.Split(field, ".")
    var value: any = obj
    for part in parts
        if value is map of string to any as m
            value = m[part]
        else
            return empty
    return value

func compareValues(a: any, b: any) int
    af, aerr := cast.ToFloat64(a)
    bf, berr := cast.ToFloat64(b)
    if aerr equals empty and berr equals empty
        if af < bf
            return -1
        if af > bf
            return 1
        return 0
    if a is string as astr
        if b is string as bstr
            return strpkg.Compare(astr, bstr)
    return 0

func evaluateCondition(objValue: any, operator: string, filterValue: any) bool
    if cast.IsNil(objValue)
        return false
    switch operator
        when "eq"
            return compareValues(objValue, filterValue) equals 0
        when "ne"
            return compareValues(objValue, filterValue) isnt 0
        when "gt"
            return compareValues(objValue, filterValue) > 0
        when "lt"
            return compareValues(objValue, filterValue) < 0
        when "gte"
            return compareValues(objValue, filterValue) >= 0
        when "lte"
            return compareValues(objValue, filterValue) <= 0
        when "contains"
            objStr := cast.ToString(objValue)
            filterStr := cast.ToString(filterValue)
            return strpkg.Contains(objStr, filterStr)
        when "in"
            if filterValue is list of any as items
                for v in items
                    if compareValues(objValue, v) equals 0
                        return true
                return false
            return false
        default
            log.Warn("Unknown operator: {operator}")
            return false

func matchesFilters(obj: map of string to any, filters: list of map of string to any) bool
    for cond in filters
        field := ""
        if cond["field"] is string as f
            field = f
        operator := ""
        if cond["operator"] is string as op
            operator = op
        value := cond["value"]
        objValue := getNestedValue(obj, field)
        if not evaluateCondition(objValue, operator, value)
            return false
    return true

func AdvancedQuery(category: string, filters: list of map of string to any, sortBy: string, sortOrder: string, limit: int, offset: int) list of map of string to any
    townData := storage.Get() onerr empty
    results := empty list of map of string to any
    cats := empty list of string
    if category isnt ""
        cats = list of string{category}
    else
        cats = getAllCategories(townData)
    for cat in cats
        catVal, ok := townData[cat]
        if not ok
            continue
        if catVal is list of any as items
            for item in items
                obj, mok := mapx.AsMap(item)
                if not mok
                    continue
                entry := cloneWithCat(obj, cat)
                if len(filters) > 0
                    if matchesFilters(entry, filters)
                        results = append(results, entry)
                else
                    results = append(results, entry)

    if sortBy isnt ""
        # sort_by is client-supplied and may be a string field, so the
        # comparator keeps the mixed-type compareValues rather than a
        # single ordered key.
        if sortOrder equals "desc"
            results = sort.ByDesc(
                results,
                (a: map of string to any, b: map of string to any) => compareValues(getNestedValue(a, sortBy), getNestedValue(b, sortBy)) > 0,
            )
        else
            results = sort.By(
                results,
                (a: map of string to any, b: map of string to any) => compareValues(getNestedValue(a, sortBy), getNestedValue(b, sortBy)) < 0,
            )

    total := len(results)
    if offset > 0 and offset < len(results)
        results = results[offset:]
    else if offset >= len(results)
        results = empty list of map of string to any
    if limit > 0 and len(results) > limit
        results = results[:limit]
    log.Info("Advanced query: found {total} objects, returning {len(results)}")
    return results
