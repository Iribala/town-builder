# Town Builder Environment Configuration
# Copy this file to .env and fill in the values

# ===========================
# JWT Authentication
# ===========================
# REQUIRED when DISABLE_JWT_AUTH=false! Generate a secure random string:
# openssl rand -hex 32
# Left empty on purpose: the server refuses to boot (loudly, with instructions)
# instead of silently running with a well-known secret.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# Secure by default. Set to 'true' ONLY for local development or when behind
# an authentication proxy (Cloudflare Tunnel, etc.).
DISABLE_JWT_AUTH=false

# ===========================
# External Django API (Optional)
# ===========================
# URL for external Django API integration
TOWN_API_URL=http://localhost:8000/api/towns/

# JWT token for authenticating with external Django API
TOWN_API_JWT_TOKEN=your_django_api_jwt_token_here

# Comma-separated list of hostnames allowed for TOWN_API_URL (SSRF prevention).
# Must include your Django server's hostname in production, or all Django API
# calls (save, load, sync) will be rejected with HTTP 400.
# Development defaults cover localhost:
ALLOWED_DOMAINS=localhost,127.0.0.1
# In production, add your Django hostname:
# ALLOWED_DOMAINS=localhost,127.0.0.1,api.yourtown.gov

# ===========================
# Kibigia Auth-Code Exchange
# ===========================
# kibigia redirects to town-builder with ?code=<single-use-auth-code> instead
# of putting the JWT in the URL. town-builder POSTs the code to this endpoint
# (with the shared secret below in the X-TownBuilder-Secret header) to redeem
# it for a JWT. The URL must be on a host listed in ALLOWED_DOMAINS.
# Default points at a local Django dev server.
KIBIGIA_EXCHANGE_URL=http://localhost:8000/issues/town-builder/exchange/
# Shared secret — MUST match kibigia's TOWN_BUILDER_EXCHANGE_SECRET.
# Generate with: openssl rand -hex 32
# Required in production (kibigia refuses to boot if empty when DEBUG=False).
KIBIGIA_EXCHANGE_SECRET=

# ===========================
# Redis Configuration
# ===========================
# Redis connection URL for multiplayer state sharing
# Default: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ===========================
# Environment
# ===========================
# Set to 'production' for production deployments. In production the server
# REFUSES TO BOOT unless ALLOWED_HOSTS is set (see below) — fail fast instead
# of 400-ing every request behind the ingress.
ENVIRONMENT=development

# ===========================
# Host allowlist (REQUIRED in production)
# ===========================
# Comma-separated hostnames the server will answer (Host header check).
# Requests to any other host are rejected with HTTP 400, including kubelet
# health probes. Development default covers localhost:
ALLOWED_HOSTS=localhost,127.0.0.1
# In production:
# ALLOWED_HOSTS=town.example.com
# If kubelet probes use the pod IP as Host, either point the probe at the
# service DNS name (httpGet.host: town-builder.<ns>.svc.cluster.local, listed
# here) or list the pod IP range.

# ===========================
# CORS Security (REQUIRED in production)
# ===========================
# Comma-separated list of allowed origins
# Development defaults:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5001,http://127.0.0.1:5001,http://localhost:5000,http://127.0.0.1:5000

# In production, set to your actual domains:
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Comma-separated CSP frame-ancestors — who may embed this app in an iframe.
# Defaults to 'self' + the origin of KIBIGIA_EXCHANGE_URL (the kibigia web
# origin, assuming exchange and web share a host). Override if the kibigia web
# origin differs from the exchange API origin:
# FRAME_ANCESTORS=https://kibigia.org

# ===========================
# Port Configuration
# ===========================
# Development mode uses port 5001 (./scripts/dev.sh)
# Production mode uses port 5000 (./scripts/prod.sh; matches Kubernetes deployment)

# ===========================
# Request Limits
# ===========================
# Maximum request body size in bytes (default: 10 MB)
MAX_REQUEST_BODY_BYTES=10485760

# Maximum number of operations in a single batch request (default: 100)
MAX_BATCH_OPERATIONS=100

# Maximum concurrent SSE connections per user (default: 3)
MAX_SSE_CONNECTIONS_PER_USER=3

# ===========================
# Security Notes
# ===========================
# - Never commit this file with actual secrets to version control
# - Always use strong, randomly generated secrets in production
# - Set ALLOWED_HOSTS to your public hostname(s) in production, or every
#   request (including health probes) is rejected with HTTP 400
# - Configure ALLOWED_ORIGINS to your actual domain(s) in production
# - Configure ALLOWED_DOMAINS to include your Django hostname in production
# - Set KIBIGIA_EXCHANGE_SECRET to match kibigia's TOWN_BUILDER_EXCHANGE_SECRET
# - Review docs/SECURITY_REVIEW.md for security best practices
# - When using DISABLE_JWT_AUTH=true, ensure you have an authentication proxy
